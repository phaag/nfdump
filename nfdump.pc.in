prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: nfdump
Description: nfdump stable read-only C ABI for nffile flow-capture files
Version: @PACKAGE_VERSION@
Libs: -L${libdir} -lnfdump
Libs.private: -lnffile @LZ4_LIBS@ @ZSTD_LIBS@ @BZ2_LIBS@ @LIBSODIUM_LIBS@ @PTHREAD_LIBS@
Cflags: -I${includedir}
