#
# Example Ubuntu Dockerfile
#
# Builds nfdump from a git ref (branch or tag) rather than a numbered
# release archive, so this keeps working during the 1.8.x beta period
# before a "v1.8.0" release tag exists. Once 1.8.0 is tagged, you can
# point NFDUMP_REF at that tag instead - a git ref works for either case.
#

# Pull base image.
FROM ubuntu:latest

ARG NFDUMP_REF=devel_1.8.x

# Expose netflow port
EXPOSE 9995/udp

# Install.
RUN apt-get update && apt-get install -y \
  git \
  wget \
  unzip \
  man \
  apt-utils \
  dialog \
  pkg-config \
  libtool \
  autoconf \
  autogen \
  bison \
  byacc \
  flex \
  make \
  libpcap-dev \
  libbz2-dev \
  liblz4-dev \
  libzstd-dev \
  libpcre2-dev \
  libsodium-dev \
  && rm -rf /var/lib/apt/lists/*

# maxmind/sflow/tor support build unconditionally in 1.8.x (no longer
# gated by --enable-maxmind/--enable-sflow, which no longer exist as
# configure options); nfpcapd is still opt-in.
RUN cd /usr/src \
  && git clone --branch "$NFDUMP_REF" --depth 1 https://github.com/phaag/nfdump.git \
  && cd nfdump \
  && ./autogen.sh \
  && ./configure --enable-nfpcapd \
  && make \
  && make install

RUN ldconfig

# Add files.
#ADD root/.bashrc /root/.bashrc
#ADD root/.gitconfig /root/.gitconfig
#ADD root/.scripts /root/.scripts

# Set environment variables.
#ENV HOME /root

# Define working directory.
WORKDIR /usr/src

# Define default command.
CMD ["bash"]
